@article{rapl-tool,
	title = {{RAPL} in {Action}: {Experiences} in {Using} {RAPL} for {Power} {Measurements}},
	volume = {3},
	issn = {2376-3639},
	shorttitle = {{RAPL} in {Action}},
	url = {https://dl.acm.org/doi/10.1145/3177754},
	doi = {10.1145/3177754},
	abstract = {To improve energy efficiency and comply with the power budgets, it is important to be able to measure the power consumption of cloud computing servers. Intel’s Running Average Power Limit (RAPL) interface is a powerful tool for this purpose. RAPL provides power limiting features and accurate energy readings for CPUs and DRAM, which are easily accessible through different interfaces on large distributed computing systems. Since its introduction, RAPL has been used extensively in power measurement and modeling. However, the advantages and disadvantages of RAPL have not been well investigated yet. To fill this gap, we conduct a series of experiments to disclose the underlying strengths and weaknesses of the RAPL interface by using both customized microbenchmarks and three well-known application level benchmarks: Stream, Stress-ng, and ParFullCMS. Moreover, to make the analysis as realistic as possible, we leverage two production-level power measurement datasets from the Taito, a supercomputing cluster of the Finnish Center of Scientific Computing and also replicate our experiments on Amazon EC2. Our results illustrate different aspects of RAPL and document the findings through comprehensive analysis. Our observations reveal that RAPL readings are highly correlated with plug power, promisingly accurate enough, and have negligible performance overhead. Experimental results suggest RAPL can be a very useful tool to measure and monitor the energy consumption of servers without deploying any complex power meters. We also show that there are still some open issues, such as driver support, non-atomicity of register updates, and unpredictable timings that might weaken the usability of RAPL in certain scenarios. For such scenarios, we pinpoint solutions and workarounds.},
	number = {2},
	urldate = {2026-06-17},
	journal = {ACM Trans. Model. Perform. Eval. Comput. Syst.},
	author = {Khan, Kashif Nizam and Hirki, Mikael and Niemi, Tapio and Nurminen, Jukka K. and Ou, Zhonghong},
	month = mar,
	year = {2018},
	keywords = {PENDIENTE},
	pages = {9:1--9:26},
	file = {Full Text PDF:/Users/guillebo/Zotero/storage/EILV4CWW/Khan et al. - 2018 - RAPL in Action Experiences in Using RAPL for Power Measurements.pdf:application/pdf},
}

@article{ec-cloud-workflows,
	title = {A workflow scheduling algorithm with task classification for reducing energy consumption and makespan in cloud},
	volume = {50},
	issn = {2210-5379},
	url = {https://www.sciencedirect.com/science/article/pii/S2210537926000338},
	doi = {10.1016/j.suscom.2026.101323},
	abstract = {With increasing popularity of cloud computing platform for extensive scientific computing, huge energy consumed by cloud data centers has become a great challenge. Therefore, significant attention has been given towards developing energy-efficient workflow scheduling algorithms in the last decade. However, the literature reveals that task classification-based scheduling has been an underexplored area. In response to this gap, this paper proposes a task classification-based dynamic scheduling (TCDS) algorithm to minimize the energy consumption (EC) and makespan when scheduling deadline-constrained workflow applications in cloud environment. TCDS consists of three main sub-algorithms: task classification, task scheduling, and dynamic resource scaling. First, considering the fact that task runtimes within a workflow are non-uniform, a new concept of execution time importance factor is introduced as a guiding principle of task classification. Accordingly, task classification algorithm marks the type of each task. The proposed task scheduler then dynamically allocates the most suitable virtual machines (VMs) to dependency-free tasks in accordance with their type and deadline constraint. To achieve balance between EC and makespan, energy-efficient and time-efficient VMs are provisioned dynamically considering the computation speed requirements and type of the tasks. In addition, TCDS performs simultaneous optimization over active number of hosts through VM consolidation, and powers-off idle hosts to minimize the EC of idle resources. To validate TCDS, extensive experiments are performed in various scenarios using real-world scientific workflows. The results verify that TCDS effectively minimizes the workflow makespan in parallel to improving energy-efficiency by 13%-40% compared with related algorithms, while demonstrating scalability under varying workloads.},
	urldate = {2026-06-16},
	journal = {Sustainable Computing: Informatics and Systems},
	author = {Kaur, Rupinder and Kaur, Gurjinder and Goraya, Major Singh},
	month = jun,
	year = {2026},
	keywords = {Cloud computing, Computation speed, Energy consumption, Task classification, Workflow scheduling},
	pages = {101323},
	file = {ScienceDirect Snapshot:/Users/guillebo/Zotero/storage/INYE4TFT/S2210537926000338.html:text/html},
}

@misc{survery-videoencoding,
	title = {A {Survey} on {Energy} {Consumption} and {Environmental} {Impact} of {Video} {Streaming}},
	url = {http://arxiv.org/abs/2401.09854},
	doi = {10.48550/arXiv.2401.09854},
	abstract = {Climate change challenges require a notable decrease in worldwide greenhouse gas (GHG) emissions across technology sectors. Digital technologies, especially video streaming, accounting for most Internet traffic, make no exception. Video streaming demand increases with remote working, multimedia communication services (e.g., WhatsApp, Skype), video streaming content (e.g., YouTube, Netflix), video resolution (4K/8K, 50 fps/60 fps), and multi-view video, making energy consumption and environmental footprint critical. This survey contributes to a better understanding of sustainable and efficient video streaming technologies by providing insights into the state-of-the-art and potential future directions for researchers, developers, and engineers, service providers, hosting platforms, and consumers. We widen this survey's focus on content provisioning and content consumption based on the observation that continuously active network equipment underneath video streaming consumes substantial energy independent of the transmitted data type. We propose a taxonomy of factors that affect the energy consumption in video streaming, such as encoding schemes, resource requirements, storage, content retrieval, decoding, and display. We identify notable weaknesses in video streaming that require further research for improved energy efficiency: (1) fixed bitrate ladders in HTTP live streaming; (2) inefficient hardware utilization of existing video players; (3) lack of comprehensive open energy measurement dataset covering various device types and coding parameters for reproducible research.},
	urldate = {2026-06-16},
	publisher = {arXiv},
	author = {Afzal, Samira and Mehran, Narges and Ourimi, Zoha Azimi and Tashtarian, Farzad and Amirpour, Hadi and Prodan, Radu and Timmerer, Christian},
	month = jan,
	year = {2024},
	note = {arXiv:2401.09854 [cs.MM]},
	keywords = {Computer Science - Multimedia},
	annote = {Encuenta consumo energetico basado en video y streaming.
    Remarca errore en protocolo http que lo hacen ineficiente para steaming de video
    Metrias de consumo energetico
    },
    	file = {Preprint PDF:/Users/guillebo/Zotero/storage/DWP7HIXK/Afzal et al. - 2024 - A Survey on Energy Consumption and Environmental Impact of Video Streaming.pdf:application/pdf;Snapshot:/Users/guillebo/Zotero/storage/8IAD3M68/2401.html:text/html},
